  "propConfig": {
    "custom.errorMessage": {
      "onChange": {
        "enabled": null,
        "script": "\n\tresult = self.custom.result\n\tif result and result.get('status') in ('SUCCESS', 'TRANSFER_PENDING'):\n\t\treturn\n\tmessage = self.custom.errorMessage\n\tif not message:\n\t\treturn\n\tsystem.kanoa.toast.show({'type': 'error', 'message': message})\n\tif 'uncertain' in message.lower() or 'supervisor' in message.lower() or 'could not load' in message.lower():\n\t\tsystem.perspective.openPopup('receivingErrorDetail', 'kanoa/core/templates/displays/messagePopup', {'text': message}, title='Receiving error', modal=True)\n\treturn"
      },
      "persistent": true
    },
    "custom.result": {
      "onChange": {
        "enabled": null,
        "script": "\n\tresult = self.custom.result\n\tif not result:\n\t\treturn\n\tstatus = result.get('status')\n\tmessage = result.get('message') or ''\n\tif status == 'SUCCESS':\n\t\tsystem.kanoa.toast.show({'type': 'success', 'message': message or 'Receipt completed. See the confirmation message for lot and transfer details.'})\n\telif status == 'TRANSFER_PENDING':\n\t\tsystem.kanoa.toast.show({'type': 'warning', 'message': message or 'Transfer pending; the lot remains at the truck. Check Pending Transfers before retrying.'})\n\treturn"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1200
    }
  },
