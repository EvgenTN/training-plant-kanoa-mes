            },
            "props": {
              "primary": false,
              "style": {
                "classes": "kanoa/button/flat"
              },
              "text": "Pending transfers"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tif self.view.custom.submitting:\n\t\treturn\n\tif self.view.custom.actualQtyKg is None or self.view.custom.truckAssetId is None or self.view.custom.tankAssetId is None:\n\t\tself.view.custom.errorMessage = 'Enter actual quantity and select a receiving truck and destination tank.'\n\t\treturn\n\tmsg = 'Confirm receipt of %s kg for order %s?' % (self.view.custom.actualQtyKg, self.view.custom.order.get('orderNumber') or 'this order')\n\tsystem.perspective.openPopup('receiptConfirmPopup', 'kanoa/core/templates/inputs/confirm', {'text': msg, 'messageHandler': 'confirmReceiveOrder'}, title='Confirm receipt', modal=True)\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSubmit",
              "name": "btnSubmit"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.submitting"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn not value",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/button/filled"
              },
              "text": "Confirm receipt"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tresultData = self.view.custom.result.get('data', {}) if self.view.custom.result else {}\n\tif not resultData.get('lotId'):\n\t\tself.view.custom.errorMessage = 'The existing receipt lot is unavailable. Use Pending Transfers or ask a supervisor.'\n\t\treturn\n\tif self.view.custom.submitting:\n\t\treturn\n\tself.view.custom.submitting = True\n\tself.view.custom.loading = True\n\ttry:\n\t\tresult = kanoaScripts.custom.ops.receiving.retryTransfer(\n\t\t\tresultData.get('lotId'),\n\t\t\tresultData.get('tankAssetId') or self.view.custom.tankAssetId,\n\t\t\tself.session.props.auth.user,\n\t\t\tresultData.get('truckAssetId')\n\t\t)\n\t\tself.view.custom.result = result\n\t\tself.view.custom.errorMessage = '' if result.get('status') in ('SUCCESS', 'TRANSFER_PENDING') else result.get('message', '')\n\texcept Exception as exc:\n\t\tkanoaScripts.custom.ops.receiving.getLogger().error('Perspective transfer retry handler failed: %s' % str(exc))\n\t\tself.view.custom.errorMessage = 'Transfer outcome may be uncertain. Refresh Pending Transfers and verify current lot location before retrying.'\n\tfinally:\n\t\tself.view.custom.submitting = False\n\tself.view.custom.loading = False"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnRetryTransfer",
              "name": "btnRetryTransfer"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.custom.result.status"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value == 'TRANSFER_PENDING'",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.submitting"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn not value",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "primary": false,
              "style": {
                "classes": "kanoa/button/outlined"
              },
              "text": "Retry transfer"
            },
            "type": "ia.input.button"
          }
