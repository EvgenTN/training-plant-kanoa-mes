{
  "custom": {
    "actualQtyKg": null,
    "errorMessage": "",
    "loading": false,
    "order": null,
    "orderNotes": null,
    "receivedQtyKg": 0,
    "result": null,
    "scheduledStart": null,
    "submitting": false,
    "tankAssetId": null,
    "tankOptions": [],
    "tankPath": null,
    "truckAssetId": null,
    "truckOptions": [],
    "truckPath": null
  },
  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\tself.custom.order = self.params.value.order if self.params.value else None"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "value": {
      "order": null,
      "orderNotes": null,
      "scheduleBlockId": null,
      "scheduledStart": null,
      "workOrderId": null
    }
  },
  "propConfig": {
    "custom.errorMessage": {
      "onChange": {
        "enabled": null,
        "script": "\tresult = self.custom.result\n\tif result and result.get('status') in ('SUCCESS', 'TRANSFER_PENDING'):\n\t\treturn\n\tmessage = self.custom.errorMessage\n\tif not message:\n\t\treturn\n\tsystem.kanoa.toast.show({'type': 'error', 'message': message})\n\tlower = message.lower()\n\tif 'uncertain' in lower or 'supervisor' in lower or 'could not load' in lower or 'reconcile' in lower:\n\t\tsystem.perspective.openPopup('receivingErrorDetail', 'kanoa/core/templates/displays/messagePopup', {'text': message}, title='Receiving error', modal=True)\n\treturn"
      },
      "persistent": true
    },
    "custom.result": {
      "onChange": {
        "enabled": null,
        "script": "\tresult = self.custom.result\n\tif not result:\n\t\treturn\n\tstatus = result.get('status')\n\tdata = result.get('data') or {}\n\torder = self.custom.order or {}\n\torderNumber = data.get('orderNumber') or order.get('orderNumber') or 'this order'\n\tlotName = data.get('lotName') or '-'\n\tquantity = data.get('quantityKg')\n\tquantityText = str(quantity) if quantity is not None else '-'\n\ttruckName = data.get('truckName') or '-'\n\ttankName = data.get('tankName') or '-'\n\tif status == 'SUCCESS':\n\t\tsystem.kanoa.toast.show({'type': 'success', 'message': 'Receipt complete for order %s: lot %s, %s kg, truck %s, tank %s.' % (orderNumber, lotName, quantityText, truckName, tankName)})\n\telif status == 'TRANSFER_PENDING':\n\t\tsystem.kanoa.toast.show({'type': 'warning', 'message': 'Receipt recorded for order %s: lot %s (%s kg) remains at truck %s. Open Pending Transfers to complete the move to tank %s.' % (orderNumber, lotName, quantityText, truckName, tankName)})\n\treturn"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1200
    }
  },
