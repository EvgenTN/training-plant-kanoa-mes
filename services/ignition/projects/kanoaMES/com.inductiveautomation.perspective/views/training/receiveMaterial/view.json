    "scripts": {
      "customMethods": null,
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "receivingTruckSelected",
          "pageScope": true,
          "script": "\tselection = payload.get('selection') or []\n\tif len(selection) == 0:\n\t\tself.view.custom.truckAssetId = None\n\t\tself.view.custom.truckPath = None\n\t\treturn\n\tvalue = selection[0].get('value') or {}\n\tassetId = value.get('assetId')\n\tif assetId is None or unicode(assetId).strip() == '':\n\t\tself.view.custom.truckAssetId = None\n\t\tself.view.custom.truckPath = None\n\t\tself.view.custom.errorMessage = 'Select a Storage Location, not a folder.'\n\t\tsystem.perspective.sendMessage('clearSelection', {'selectorId': payload.get('selectorId')})\n\t\treturn\n\tself.view.custom.truckAssetId = assetId\n\tself.view.custom.truckPath = value.get('path') or value.get('assetPath')\n\tself.view.custom.errorMessage = ''\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "receivingTankSelected",
          "pageScope": true,
          "script": "\tselection = payload.get('selection') or []\n\tif len(selection) == 0:\n\t\tself.view.custom.tankAssetId = None\n\t\tself.view.custom.tankPath = None\n\t\treturn\n\tvalue = selection[0].get('value') or {}\n\tassetId = value.get('assetId')\n\tif assetId is None or unicode(assetId).strip() == '':\n\t\tself.view.custom.tankAssetId = None\n\t\tself.view.custom.tankPath = None\n\t\tself.view.custom.errorMessage = 'Select a Storage Location, not a folder.'\n\t\tsystem.perspective.sendMessage('clearSelection', {'selectorId': payload.get('selectorId')})\n\t\treturn\n\tself.view.custom.tankAssetId = assetId\n\tself.view.custom.tankPath = value.get('path') or value.get('assetPath')\n\tself.view.custom.errorMessage = ''\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "confirmReceiveOrder",
          "pageScope": true,
          "script": "\tfrom threading import RLock\n\tlockKey = 'kanoaReceivingSubmit:%s:%s' % (self.session.props.id, self.view.id)\n\tlock = system.util.getGlobals().setdefault(lockKey, RLock())\n\twith lock:\n\t\tpriorResult = self.view.custom.result\n\t\tif priorResult and priorResult.get('status') in ('SUCCESS', 'TRANSFER_PENDING'):\n\t\t\treturn\n\t\tif self.view.custom.submitting:\n\t\t\treturn\n\t\tself.view.custom.submitting = True\n\t\tself.view.custom.loading = True\n\t\ttry:\n\t\t\tworkOrderId = self.view.custom.order.get('workOrderId')\n\t\t\tresult = kanoaScripts.custom.ops.receiving.receiveOrder(\n\t\t\t\tworkOrderId,\n\t\t\t\tself.view.custom.actualQtyKg,\n\t\t\t\tself.view.custom.truckAssetId,\n\t\t\t\tself.view.custom.tankAssetId,\n\t\t\t\tself.session.props.auth.user\n\t\t\t)\n\t\t\tself.view.custom.result = result\n\t\t\tself.view.custom.errorMessage = '' if result.get('status') in ('SUCCESS', 'TRANSFER_PENDING') else result.get('message', '')\n\t\texcept Exception as exc:\n\t\t\tkanoaScripts.custom.ops.receiving.getLogger().error('Perspective receive handler failed: %s' % str(exc))\n\t\t\tself.view.custom.errorMessage = 'Receipt outcome may be uncertain. Check Pending Transfers or ask a supervisor before retrying.'\n\t\tfinally:\n\t\t\tself.view.custom.submitting = False\n\t\t\tself.view.custom.loading = False\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
