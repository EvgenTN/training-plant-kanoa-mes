          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(view='training/pendingTransfers')"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnPending",
              "name": "btnPending"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "primary": false,
              "style": {
                "classes": "kanoa/button/flat"
              },
              "text": "Pending transfers"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tif self.view.custom.submitting:\n\t\treturn\n\tif self.view.custom.actualQtyKg is None or self.view.custom.truckAssetId is None or self.view.custom.tankAssetId is None:\n\t\tself.view.custom.errorMessage = 'Enter actual quantity and select a receiving truck and destination tank.'\n\t\treturn\n\tself.view.custom.submitting = True\n\ttry:\n\t\tworkOrderId = self.view.custom.order.get('workOrderId')\n\t\tresult = kanoaScripts.custom.ops.receiving.receiveOrder(\n\t\t\tworkOrderId,\n\t\t\tself.view.custom.actualQtyKg,\n\t\t\tself.view.custom.truckAssetId,\n\t\t\tself.view.custom.tankAssetId,\n\t\t\tself.session.props.auth.user\n\t\t)\n\t\tself.view.custom.result = result\n\t\tself.view.custom.errorMessage = '' if result.get('status') in ('SUCCESS', 'TRANSFER_PENDING') else result.get('message', '')\n\texcept Exception as exc:\n\t\tkanoaScripts.custom.ops.receiving.getLogger().error('Perspective receive handler failed: %s' % str(exc))\n\t\tself.view.custom.errorMessage = 'Receipt outcome may be uncertain. Check Pending Transfers or ask a supervisor before retrying.'\n\tfinally:\n\t\tself.view.custom.submitting = False"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSubmit",
              "name": "btnSubmit"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.submitting"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn not value",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/button/primary"
              },
              "text": "Confirm receipt"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tresultData = self.view.custom.result.get('data', {}) if self.view.custom.result else {}\n\tif not resultData.get('lotId'):\n\t\tself.view.custom.errorMessage = 'The existing receipt lot is unavailable. Use Pending Transfers or ask a supervisor.'\n\t\treturn\n\tif self.view.custom.submitting:\n\t\treturn\n\tself.view.custom.submitting = True\n\ttry:\n\t\tresult = kanoaScripts.custom.ops.receiving.retryTransfer(\n\t\t\tresultData.get('lotId'),\n\t\t\tresultData.get('tankAssetId') or self.view.custom.tankAssetId,\n\t\t\tself.session.props.auth.user,\n\t\t\tresultData.get('truckAssetId')\n\t\t)\n\t\tself.view.custom.result = result\n\t\tself.view.custom.errorMessage = '' if result.get('status') in ('SUCCESS', 'TRANSFER_PENDING') else result.get('message', '')\n\texcept Exception as exc:\n\t\tkanoaScripts.custom.ops.receiving.getLogger().error('Perspective transfer retry handler failed: %s' % str(exc))\n\t\tself.view.custom.errorMessage = 'Transfer outcome may be uncertain. Refresh Pending Transfers and verify current lot location before retrying.'\n\tfinally:\n\t\tself.view.custom.submitting = False"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnRetryTransfer",
              "name": "btnRetryTransfer"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.custom.result.status"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value == 'TRANSFER_PENDING'",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.submitting"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn not value",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "primary": false,
              "style": {
                "classes": "kanoa/button/flat"
              },
              "text": "Retry transfer"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "domId": "actions",
          "name": "actions"
        },
        "props": {
          "style": {
            "alignItems": "center",
            "flexWrap": "wrap",
            "gap": 10
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "component": {
        "onStartup": {
          "config": {
            "script": "\tself.view.custom.loading = True\n\tself.view.custom.errorMessage = ''\n\tself.view.custom.result = None\n\ttry:\n\t\tparams = self.view.params.value or {}\n\t\torder = params.get('order') or {}\n\t\tworkOrderId = params.get('workOrderId') or order.get('workOrderId')\n\t\tif not order and workOrderId is not None:\n\t\t\torderResult = kanoaScripts.custom.ops.receiving.getReceivingOrder(workOrderId)\n\t\t\tif orderResult.get('status') == 'SUCCESS':\n\t\t\t\torder = orderResult.get('data', {}).get('order', {})\n\t\t\telse:\n\t\t\t\tself.view.custom.errorMessage = orderResult.get('message', 'Order is not eligible.')\n\t\tself.view.custom.order = order\n\t\tif workOrderId is None:\n\t\t\tself.view.custom.errorMessage = 'No eligible order was selected. Return to the schedule and select an order.'\n\t\t\treturn\n\t\tassetsResult = kanoaScripts.custom.ops.receiving.getReceivingAssets()\n\t\tif assetsResult.get('status') == 'SUCCESS':\n\t\t\tassets = assetsResult.get('data', {})\n\t\t\tself.view.custom.truckOptions = [{'label': a.get('assetPath') or a.get('assetName'), 'value': a.get('assetId')} for a in assets.get('trucks', [])]\n\t\t\tself.view.custom.tankOptions = [{'label': a.get('assetPath') or a.get('assetName'), 'value': a.get('assetId')} for a in assets.get('tanks', [])]\n\t\telse:\n\t\t\tself.view.custom.errorMessage = assetsResult.get('message', 'Receiving assets could not be loaded.')\n\t\tqtyResult = kanoaScripts.custom.ops.receiving.getReceivedQtyForOrder(workOrderId)\n\t\tif qtyResult.get('status') == 'SUCCESS':\n\t\t\tself.view.custom.receivedQtyKg = qtyResult.get('data', {}).get('receivedQtyKg', 0)\n\t\telse:\n\t\t\tself.view.custom.errorMessage = qtyResult.get('message', 'Receipt history could not be loaded.')\n\texcept Exception as exc:\n\t\tkanoaScripts.custom.ops.receiving.getLogger().error('Receive Material startup failed: %s' % str(exc))\n\t\tself.view.custom.errorMessage = 'Could not load the selected order or receiving data. Return to the schedule or contact a supervisor.'\n\tfinally:\n\t\tself.view.custom.loading = False"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/container",
        "gap": 12,
        "padding": 20
      }
    },
    "type": "ia.container.flex"
  }
}
