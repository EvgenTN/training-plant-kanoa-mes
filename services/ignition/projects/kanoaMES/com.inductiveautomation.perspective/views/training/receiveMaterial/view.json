  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\tself.custom.order = self.params.value.order"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "value": {
      "order": null,
      "scheduleBlockId": null,
      "workOrderId": null
