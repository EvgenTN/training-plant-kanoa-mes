    "events": {
      "component": {
        "onStartup": {
          "config": {
            "script": "\tself.view.custom.loading = True\n\tself.view.custom.errorMessage = ''\n\tself.view.custom.result = None\n\tself.view.custom.actualQtyKg = None\n\ttry:\n\t\tparams = self.view.params.value or {}\n\t\torder = params.get('order') or {}\n\t\tworkOrderId = params.get('workOrderId') or order.get('workOrderId')\n\t\tself.view.custom.scheduledStart = params.get('scheduledStart')\n\t\tself.view.custom.orderNotes = params.get('orderNotes')\n\t\tif not order and workOrderId is not None:\n\t\t\torderResult = kanoaScripts.custom.ops.receiving.getReceivingOrder(workOrderId)\n\t\t\tif orderResult.get('status') == 'SUCCESS':\n\t\t\t\torder = orderResult.get('data', {}).get('order', {})\n\t\t\telse:\n\t\t\t\tself.view.custom.errorMessage = orderResult.get('message', 'Order is not eligible.')\n\t\tself.view.custom.order = order\n\t\tif workOrderId is None:\n\t\t\tself.view.custom.errorMessage = 'No eligible order was selected. Return to the schedule and select an order.'\n\t\t\treturn\n\t\tif not self.view.custom.orderNotes:\n\t\t\ttry:\n\t\t\t\torderRows = system.kanoa.order.getProductionOrders({'workOrderId': workOrderId, 'ignoreActualQty': True})\n\t\t\t\tself.view.custom.orderNotes = system.kanoa.utilities.getFieldValue('note', orderRows)\n\t\t\texcept Exception as notesExc:\n\t\t\t\tkanoaScripts.custom.ops.receiving.getLogger().error('Receive Material notes load failed: %s' % str(notesExc))\n\t\tassetsResult = kanoaScripts.custom.ops.receiving.getReceivingAssets()\n\t\tif assetsResult.get('status') == 'SUCCESS':\n\t\t\tassets = assetsResult.get('data', {})\n\t\t\tself.view.custom.truckOptions = [{'label': a.get('assetPath') or a.get('assetName'), 'value': a.get('assetId')} for a in assets.get('trucks', [])]\n\t\t\tself.view.custom.tankOptions = [{'label': a.get('assetPath') or a.get('assetName'), 'value': a.get('assetId')} for a in assets.get('tanks', [])]\n\t\telse:\n\t\t\tself.view.custom.errorMessage = assetsResult.get('message', 'Receiving assets could not be loaded.')\n\t\tqtyResult = kanoaScripts.custom.ops.receiving.getReceivedQtyForOrder(workOrderId)\n\t\tif qtyResult.get('status') == 'SUCCESS':\n\t\t\tself.view.custom.receivedQtyKg = qtyResult.get('data', {}).get('receivedQtyKg', 0)\n\t\t\ttry:\n\t\t\t\ttargetQty = float(self.view.custom.order.get('targetQty'))\n\t\t\texcept (TypeError, ValueError):\n\t\t\t\ttargetQty = None\n\t\t\tif targetQty is not None and targetQty > 0:\n\t\t\t\tremaining = max(0, targetQty - float(self.view.custom.receivedQtyKg or 0))\n\t\t\t\tself.view.custom.actualQtyKg = remaining\n\t\t\t\tif remaining <= 0:\n\t\t\t\t\tself.view.custom.errorMessage = 'This order is fully received. No further receipt can be recorded.'\n\t\t\telse:\n\t\t\t\tself.view.custom.errorMessage = 'The order target quantity is unavailable or not greater than zero. Receiving is blocked until a supervisor corrects the order.'\n\t\telse:\n\t\t\tself.view.custom.receivedQtyKg = None\n\t\t\tself.view.custom.errorMessage = qtyResult.get('message', 'Receipt history could not be loaded. Do not retry until the order is reconciled.')\n\texcept Exception as exc:\n\t\tkanoaScripts.custom.ops.receiving.getLogger().error('Receive Material startup failed: %s' % str(exc))\n\t\tself.view.custom.errorMessage = 'Could not load the selected order or receiving data. Return to the schedule or contact a supervisor.'\n\tfinally:\n\t\tself.view.custom.loading = False"
          },
          "scope": "G",
          "type": "script"
        }
      }
