                    "script": "\tif self.view.custom.submitting:\n\t\treturn\n\tif not self.view.custom.order:\n\t\tself.view.custom.errorMessage = 'No eligible order was selected. Return to the schedule and select an order.'\n\t\treturn\n\tif self.view.custom.actualQtyKg is None or self.view.custom.truckAssetId is None or self.view.custom.tankAssetId is None:\n\t\tself.view.custom.errorMessage = 'Enter an actual quantity and select a receiving truck and destination tank.'\n\t\treturn\n\tmsg = 'Confirm receipt of %s kg for order %s?' % (self.view.custom.actualQtyKg, self.view.custom.order.get('orderNumber') or 'this order')\n\tsystem.perspective.openPopup('receiptConfirmPopup', 'kanoa/core/templates/inputs/confirm', {'text': msg, 'messageHandler': 'confirmReceiveOrder'}, title='Confirm receipt', modal=True)\n\treturn"
