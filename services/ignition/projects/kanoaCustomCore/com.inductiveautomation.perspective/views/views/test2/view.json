          "script": "\t# Configuration data for dynamically embedded components/View instances\n\tcomponents_config \u003d [\n\t\t{\"label\": \"lab 1\", \"enabled\": True, \"value\": self.custom.inputValue1},\n\t\t{\"label\": \"lab 2\", \"enabled\": True, \"value\": self.custom.inputValue2},\n\t\t{\"label\": \"lab 3\", \"enabled\": False, \"value\": self.custom.inputValue3}\n\t]\n\n\tinstances \u003d []\n\tfor cfg in components_config:\n\t\tinstances.append({\n\t\t\t\"label\": cfg.get(\"label\", \"\"),\n\t\t\t\"enabled\": cfg.get(\"enabled\", True),\n\t\t\t\"value\": cfg.get(\"value\", \"\")\n\t\t})\n\n\trepeater \u003d self.getChild(\"root\").getChild(\"FlexContainer_1\").getChild(\"DynamicViewRepeater\")\n\trepeater.props.instances \u003d instances"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
